    function updatePreview() {
      const t = editTitle.value.trim();
      const d = editDesc.value.trim();
      const u = editUrl.value.trim();
      const r = editRating.value.trim();

      prevTitle.textContent = t || "Untitled Page — MediPortal247";
      prevDesc.textContent = d || "No description provided.";
      prevUrl.textContent = u || "https://mediportal247.com";

      if (r) {
        prevRichRow.hidden = false;
        prevRating.textContent = `Rating: ${r}/10 · 24,190 votes`;
      } else {
        prevRichRow.hidden = true;
      }

      // Title Char Count & Meter
      const tLen = t.length;
      titleChar.textContent = `${tLen} / 60 chars`;
      titleMeter.style.width = Math.min(100, (tLen / 60) * 100) + "%";
      titleMeter.style.background = tLen > 65 ? "#ef4444" : tLen < 30 ? "#f59e0b" : "#10b981";

      // Desc Char Count & Meter
      const dLen = d.length;
      descChar.textContent = `${dLen} / 160 chars`;
      descMeter.style.width = Math.min(100, (dLen / 160) * 100) + "%";
      descMeter.style.background = dLen > 160 ? "#ef4444" : dLen < 80 ? "#f59e0b" : "#10b981";

      // Update Code Box
      const presetKey = presetSelect.value;
      const type = presets[presetKey] ? presets[presetKey].type : "WebPage";

      const code = `<!-- Primary SEO Meta Tags -->
<title>${escapeXml(t)}</title>
<meta name="title" content="${escapeXml(t)}">
<meta name="description" content="${escapeXml(d)}">
<link rel="canonical" href="${escapeXml(u.replace(/ › /g, "/"))}">

<!-- Open Graph / Facebook / Twitter -->
<meta property="og:title" content="${escapeXml(t)}">
<meta property="og:description" content="${escapeXml(d)}">
<meta property="og:url" content="${escapeXml(u.replace(/ › /g, "/"))}">

<!-- Schema.org Google SERP Rich Snippet -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "${type}",
  "name": "${escapeXml(t)}",
  "description": "${escapeXml(d)}"${r ? `,\n  "aggregateRating": {\n    "@type": "AggregateRating",\n    "ratingValue": "${r}",\n    "bestRating": "10",\n    "ratingCount": "24190"\n  }` : ""}
}
<\/script>`;

      codeOutput.textContent = code;
    }

    function escapeXml(s) {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    // Event listeners
    editTitle.addEventListener("input", updatePreview);
    editDesc.addEventListener("input", updatePreview);
    editUrl.addEventListener("input", updatePreview);
    editRating.addEventListener("input", updatePreview);

    presetSelect.addEventListener("change", () => {
      const p = presets[presetSelect.value];
      if (p) {
        editTitle.value = p.title;
        editDesc.value = p.desc;
        editUrl.value = p.url;
        editRating.value = p.rating;
        updatePreview();
      }
    });

    // View toggles
    btnDesktop.addEventListener("click", () => {
      btnDesktop.classList.add("active");
      btnMobile.classList.remove("active");
      previewWindow.classList.add("desktop-mode");
      previewWindow.classList.remove("mobile-mode");
    });

    btnMobile.addEventListener("click", () => {
      btnMobile.classList.add("active");
      btnDesktop.classList.remove("active");
      previewWindow.classList.add("mobile-mode");
      previewWindow.classList.remove("desktop-mode");
    });

    // Copy code button
    copyCodeBtn.addEventListener("click", () => {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(codeOutput.textContent).then(() => {
          copyCodeBtn.textContent = "Copied! ✓";
          setTimeout(() => (copyCodeBtn.textContent = "📋 Copy Code"), 2500);
        });
      }
    });

    // Initial run
    updatePreview();
  });
</script>

