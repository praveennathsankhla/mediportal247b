        url: "https://mediportal247.com › movie › with-honors-1994",
        rating: "6.7",
        type: "Movie",
      },
      home: {
        title: "MediPortal247 — Download Bollywood, Hollywood & Dual Audio Movies 480p, 720p, 1080p, 4K",
        desc: "Download latest Bollywood, Hollywood, Dual Audio Movies and Web Series in 480p, 720p, 1080p and 4K Ultra HD. Fast Google Drive, Cloud Links with Hindi Dubbed & Subtitles.",
        url: "https://mediportal247.com",
