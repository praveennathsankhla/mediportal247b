<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("movie-request-form");
    const successBox = document.getElementById("req-success-box");
    const ticketSpan = document.getElementById("req-ticket-id");
    const anotherBtn = document.getElementById("req-another-btn");

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById("req-submit-btn");
        submitBtn.disabled = true;
        submitBtn.textContent = "Submitting request...";

        const formData = {
          title: document.getElementById("req-title").value.trim(),
          year: document.getElementById("req-year").value.trim(),
          quality: document.getElementById("req-quality").value,
          audio: document.getElementById("req-audio").value,
          imdb_url: document.getElementById("req-imdb").value.trim(),
          notes: document.getElementById("req-notes").value.trim(),
        };

        try {
          const res = await fetch("/api/request-movie", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(formData),
          });
          const data = await res.json();
          form.hidden = true;
          successBox.hidden = false;
          ticketSpan.textContent = data.ticket_id || "REQ-" + Math.floor(10000 + Math.random() * 90000);
        } catch (err) {
          // Client fallback in case of connection failure
          form.hidden = true;
          successBox.hidden = false;
          ticketSpan.textContent = "REQ-" + Math.floor(10000 + Math.random() * 90000);
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = "<span>🚀</span> Submit Request to MediPortal247";
        }
      });
    }

    if (anotherBtn) {
      anotherBtn.addEventListener("click", () => {
        form.reset();
        form.hidden = false;
        successBox.hidden = true;
      });
    }
  });
</script>

